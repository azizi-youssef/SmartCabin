# Local development only. Copy to .env.local and fill in from `pnpm stack:status`.
# Never put a service-role key in a NEXT_PUBLIC_ variable (it would ship to browsers).

# Supabase API (local stack: `pnpm stack:start`). Public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Database integration tests (local stack, not a secret).
# Use 127.0.0.1 rather than localhost on Windows (IPv6 lookups stall on Docker ports).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Notifications worker (module 9) — server only, never NEXT_PUBLIC_ ---
# Shared secret of POST /api/internal/jobs/dispatch (HMAC-SHA256 signature) and job key of the
# database worker functions: at least 32 random characters, e.g. `openssl rand -hex 32`.
# Store its SHA-256 with private.set_job_key_hash() and the same value in the Vault secret
# smartcabin_jobs_secret (see docs/DATABASE_SCHEMA.md, deployment notes).
JOBS_SECRET=
# disabled (default: messages stay planned, nothing is sent) | simulator (development, staging)
NOTIFICATIONS_PROVIDER=disabled

# --- CAPTCHA (SC-AUD-01): Cloudflare Turnstile on sign-up, sign-in, SMS code, password reset ---
# Public site key: the forms show the widget only when it is set.
# Secret: read by Supabase Auth (supabase/config.toml, [auth.captcha]); set it in the environment of
# `supabase start` (shell or supabase/.env) and in the hosted project's Auth settings. Never in the app.
# The values below are Cloudflare's documented test keys, which always pass: development only.
# Production needs the real keys of a Turnstile widget restricted to the app's domain.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA

# --- Local stack only: patient sign-in without an SMS provider ---
# The Supabase CLI reads supabase/.env.local (git-ignored) by itself; put the CAPTCHA secret above there,
# plus these overrides of config.toml, which switch phone login on with placeholder provider values.
# Only the test number of [auth.sms.test_otp] in config.toml can then sign in (its code is fixed, no SMS
# is sent); real numbers fail to send. Never in a hosted project.
# SUPABASE_AUTH_SMS_TWILIO_ENABLED=true
# SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=AC_LOCAL_PLACEHOLDER
# SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=MG_LOCAL_PLACEHOLDER
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=local-placeholder
