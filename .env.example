# Local development only. Copy to .env.local and fill in from `pnpm stack:status`.
# Never put a service-role key in a NEXT_PUBLIC_ variable (it would ship to browsers).

# Supabase API (local stack: `pnpm stack:start`). Public by design; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Database integration tests (local stack, not a secret).
# Use 127.0.0.1 rather than localhost on Windows (IPv6 lookups stall on Docker ports).
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
